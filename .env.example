# start-local.ps1 fills the blank secrets when it creates the ignored root .env.
# Existing platform infrastructure
POSTGRES_USER=tutor
POSTGRES_PASSWORD=
POSTGRES_DB=tutor_platform
REDIS_PASSWORD=

# Education has its own database and S3 user. Generate passwords locally.
EDUCATION_DB_USER=education
EDUCATION_DB_PASSWORD=
EDUCATION_DB_HOST_PORT=5433
EDUCATION_DB_URL=jdbc:postgresql://localhost:5433/education
MINIO_ROOT_USER=local-minio-admin
MINIO_ROOT_PASSWORD=
EDUCATION_S3_ACCESS_KEY=education-local
EDUCATION_S3_SECRET_KEY=
EDUCATION_S3_BUCKET=education-private
EDUCATION_S3_ENDPOINT=http://localhost:9000
EDUCATION_PORT=8081
EDUCATION_JWT_ISSUER=rp-identity
EDUCATION_JWT_PUBLIC_KEY_LOCATION=file:../../dev_secrets/jwt_public.pem
EDUCATION_IDENTITY_BASE_URL=http://localhost:8080
# Generate once: Base64 of 32 random bytes; keep stable across restarts.
EDUCATION_CURSOR_KEY=
EDUCATION_ASSIGNMENT_TOKEN=
EDUCATION_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
EDUCATION_SCHEDULE_TOPIC=education.schedule.v1
EDUCATION_OUTBOX_ENABLED=true

# Assignment uses a database and S3 credentials distinct from Education.
ASSIGNMENT_DB_USER=assignment
ASSIGNMENT_DB_PASSWORD=
ASSIGNMENT_DB_HOST_PORT=5434
ASSIGNMENT_DB_URL=jdbc:postgresql://localhost:5434/assignment
ASSIGNMENT_S3_ENDPOINT=http://localhost:9000
ASSIGNMENT_S3_BUCKET=assignment-private
ASSIGNMENT_S3_ACCESS_KEY=assignment-local
ASSIGNMENT_S3_SECRET_KEY=
ASSIGNMENT_PORT=8082
# Three independent Base64-encoded 32-byte secrets. Compose gives each provider only its own key.
ASSIGNMENT_IDENTITY_SIGNING_KEY=
ASSIGNMENT_EDUCATION_SIGNING_KEY=
ASSIGNMENT_CURSOR_KEY=
ASSIGNMENT_IDENTITY_URL=http://localhost:8080
ASSIGNMENT_EDUCATION_URL=http://localhost:8081
ASSIGNMENT_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Identity settings for running the process outside Docker.
IDENTITY_DB_URL=jdbc:postgresql://localhost:5432/tutor_platform
REDIS_HOST=localhost
REDIS_PORT=6379
JWT_ISSUER=rp-identity
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
STUDENT_CREDENTIALS_KEY=
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
